# ---------------------------------------------------------------------------
# LLM provider. The stack auto-detects in this order: groq -> gemini -> openai
# -> ollama -> extractive (offline, no key required).
# Set LLM_PROVIDER to pin one explicitly.
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto

# Groq free tier - https://console.groq.com (no credit card)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini free tier - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama - https://ollama.com  (ollama pull qwen2.5:7b-instruct)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# Separate (usually cheaper/local) model used by the evaluation LLM-judge.
# Leave blank to reuse the main generation model.
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-20b

# Reasoning models (gpt-oss, o-series): low | medium | high
REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# Embeddings + reranking (run locally on CPU/MPS, no keys needed)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DEVICE=auto

# ---------------------------------------------------------------------------
# Vector store: faiss (local file) or qdrant (docker)
# ---------------------------------------------------------------------------
VECTOR_BACKEND=faiss
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=healthcare_chunks

# ---------------------------------------------------------------------------
# Retrieval defaults
# ---------------------------------------------------------------------------
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
HYBRID_ALPHA=0.5

# ---------------------------------------------------------------------------
# Optional: mirror raw documents to S3
# ---------------------------------------------------------------------------
S3_BUCKET=
AWS_REGION=us-east-1

API_BASE_URL=http://localhost:8000
